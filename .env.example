# Comma-separated key pool, at least 2 keys. Key ids will be key_1, key_2, ... in this order.
LLM_API_KEYS=your_first_api_key_here,your_second_api_key_here

# SQLite database location (for local outside docker: sqlite:///./data/app.db; for docker: sqlite:////data/app.db)
DATABASE_URL=sqlite:////data/app.db

# Comma-separated CORS origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Enable failover test hook via X-Simulate-Failure header (true/false)
ENABLE_FAILURE_SIMULATION=true

# LiteLLM model name to route queries to
LLM_MODEL=gemini/gemini-3.5-flash-lite

# LiteLLM built-in cache backend
CACHE_TYPE=local

# Use LiteLLM's bundled model catalogue so startup does not depend on GitHub.
LITELLM_LOCAL_MODEL_COST_MAP=true
